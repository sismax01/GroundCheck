# ============================================================================
# GroundCheck Configuration (.env.example)
# Copy this file to `.env` and adjust settings as needed.
# Do NOT commit real secrets or API keys to version control.
# ============================================================================

# Application Server Settings
GROUNDCHECK_HOST=127.0.0.1
GROUNDCHECK_PORT=8000
GROUNDCHECK_LOG_LEVEL=INFO

# Persistence & Corpus Settings
GROUNDCHECK_DB_PATH=data/groundcheck.db
GROUNDCHECK_AUTO_SEED_SAMPLE_DOCS=true
GROUNDCHECK_MAX_UPLOAD_MB=25

# Chunking & Indexing Defaults
GROUNDCHECK_CHUNK_SIZE=650
GROUNDCHECK_CHUNK_OVERLAP=110

# Hybrid Retrieval Defaults
# Mode options: hybrid | bm25 | semantic
GROUNDCHECK_DEFAULT_RETRIEVAL_MODE=hybrid
GROUNDCHECK_DEFAULT_TOP_K=5
# Alpha controls lexical vs semantic blend (1.0 = pure BM25, 0.0 = pure semantic vector)
GROUNDCHECK_DEFAULT_ALPHA=0.55
# Minimum evidence relevance score [0.0 - 1.0] required to consider a passage supporting
GROUNDCHECK_MIN_EVIDENCE_SCORE=0.18

# Answer Generation Mode
# Mode options:
#   extractive - Deterministic, zero-cost local evidence synthesis (No API key required; default)
#   llm        - External OpenAI-compatible chat completion API with strict citation constraints
GROUNDCHECK_GENERATION_MODE=extractive

# External LLM Provider Settings (Required ONLY when GROUNDCHECK_GENERATION_MODE=llm)
GROUNDCHECK_LLM_API_KEY=your_api_key_here
GROUNDCHECK_LLM_BASE_URL=https://api.openai.com/v1
GROUNDCHECK_LLM_MODEL=gpt-4o-mini
GROUNDCHECK_LLM_TIMEOUT_SECONDS=20

# Cost Estimation Reference Rates (USD per 1,000,000 tokens, used for transparent cost projections)
GROUNDCHECK_COST_INPUT_PER_1M=0.15
GROUNDCHECK_COST_OUTPUT_PER_1M=0.60
